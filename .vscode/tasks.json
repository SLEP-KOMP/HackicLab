{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Тесты",
      "type": "shell",
      "command": "python -m unittest discover -s tests -t tests -v",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Ruff: проверка",
      "type": "shell",
      "command": "python -m ruff check .",
      "problemMatcher": [
        {
          "owner": "ruff",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "pattern": {
            "regexp": "^(.*?):(\\d+):(\\d+):?\\s+(\\w+)\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "code": 4,
            "message": 5
          }
        }
      ]
    },
    {
      "label": "Ruff: исправить",
      "type": "shell",
      "command": "python -m ruff check --fix .",
      "problemMatcher": []
    },
    {
      "label": "Ruff: проверить i18n целиком",
      "type": "shell",
      "command": "python -m unittest discover -s tests -t tests -p test_i18n.py -v",
      "problemMatcher": []
    },
    {
      "label": "Собрать EXE",
      "type": "shell",
      "command": "python -m PyInstaller --noconfirm --clean HackicLab.spec",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Установить зависимости",
      "type": "shell",
      "command": "python -m pip install -r requirements.txt",
      "problemMatcher": []
    },
    {
      "label": "Проверка перед релизом",
      "dependsOn": [
        "Ruff: проверка",
        "Тесты"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
